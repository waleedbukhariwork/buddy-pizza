# =============================================================================
# Buddy Feast — Environment Variables Reference
# =============================================================================
# Copy this file and use it as a reference when setting up environments.
# For local dev: only backend vars are needed (via application-local.properties)
# For Render: set these in the Dashboard or render.yaml
#
# ── Environments ─────────────────────────────────────────────────────────
# local   → uses application-local.properties (gitignored)
# dev     → Render project "buddy-feast-dev"
# staging → Render project "buddy-feast-staging"
# prod    → Render project "buddy-feast-prod"
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/buddy_feast_db
DB_USERNAME=buddy_user
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=86400000

# ── CORS (comma-separated frontend origins) ──────────────────────────────
# Dev:
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Production (example):
# CORS_ALLOWED_ORIGINS=https://customer.yourdomain.com,https://admin.yourdomain.com,https://rider.yourdomain.com

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Buddy Feast <no-reply@contact.yumzoy.shop>

# ── Cloudinary ───────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend (set in each app's Render service) ──────────────────────────
# NEXT_PUBLIC_API_URL=https://buddy-feast-api.onrender.com/api
# BACKEND_URL=https://buddy-feast-api.onrender.com
